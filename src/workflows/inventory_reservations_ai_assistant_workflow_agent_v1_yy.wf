        {
          "id": "57",
          "code": "REALLOC_SELECT_ELIGIBLE_LINES",
          "type": "CODE",
          "metadata": {
            "name": "Realloc Select Eligible Lines",
            "sourceCode": "const items = $context.$nodes.REALLOC_DEMAND_LINES.$output.items || []; const lines = items.filter(function (it) { const requested = Number(it.RequestedQuantity || 0); const availableRaw = it.AvailableToReserveOnhand != null ? it.AvailableToReserveOnhand : (it.ReservedQuantity != null ? it.ReservedQuantity : 0); const available = Number(availableRaw || 0); return requested > 0 && available >= requested; }); return { lines: lines };",
            "returnType": "object"
          },
          "outcomes": {
            "success": "58"
          },
          "inputs": [],
          "diagram": {
            "x": 10100,
            "y": 9700
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
