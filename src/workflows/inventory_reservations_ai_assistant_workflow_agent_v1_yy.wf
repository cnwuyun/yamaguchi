          "inputs": [
            {
              "id": "29_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "You render inventory reservation details into a clean user-facing reply. Show only these columns: Demand Document Type, Demand Document Number, Demand Document Line Number, Reservation Quantity, Demand Quantity, Expected Date, Item Number, Organization Code, and Reservation UOM Code. Never reveal any internal ID fields such as organization ID, item ID, or document IDs.\n\nplease output Japanese language.\n"
            },
            {
              "id": "29_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Render the reservation details for the user. Data: {{$context.$nodes.VIEW_RESERVATIONS.$output}}. \n\nplease show a table.\nplease output Japanese language.\nReturn a concise, friendly summary.\n"
            }
