        {
          "id": "8",
          "code": "PREPARE_VIEW_QUERY",
          "type": "CODE",
          "metadata": {
            "name": "Prepare View Query",
            "description": "Builds the reservation-details pQuery filter string from the classified request.",
            "sourceCode": "const r = $context.$nodes.CLASSIFY_REQUEST.$output.result; const q = String.fromCharCode(39); const parts = []; if (r.organizationCode) { parts.push('OrganizationCode=' + q + r.organizationCode + q); } if (r.itemNumber) { parts.push('ItemNumber=' + q + r.itemNumber + q); } if (r.demandSourceTypeId) { parts.push('DemandSourceTypeId=' + q + r.demandSourceTypeId + q); } if (r.demandSourceHeaderNumber) { parts.push('DemandSourceHeaderNumber=' + q + r.demandSourceHeaderNumber + q); } if (r.reservationStatus) { parts.push('ReservationStatus=' + q + r.reservationStatus + q); } if (r.expectedStartDate) { parts.push('ExpectedDate>=' + q + r.expectedStartDate + q); } if (r.expectedEndDate) { parts.push('ExpectedDate<=' + q + r.expectedEndDate + q); } return { pQuery: parts.join(' AND ') };",
            "returnType": "object"
          },
          "outcomes": {
            "success": "13"
          },
          "inputs": [],
          "diagram": {
            "x": 8750,
            "y": 7204
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "9",
          "code": "PREPARE_DEMAND_QUERY",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Demand Query",
            "sourceCode": "const r = $context.$nodes.CLASSIFY_REQUEST.$output.result;\nconst q = String.fromCharCode(39);\nconst v = $context.$nodes.VALIDATE_ITEM.$output;\nconst itemId = (v && v.items && v.items.length > 0 && v.items[0].ItemId) ? v.items[0].ItemId : '';\nconst parts = [];\nif (r.organizationCode) { parts.push('OrganizationCode=' + q + r.organizationCode + q); }\nif (r.customerName) { parts.push('upper(customerName) like upper(' + q + '%' + r.customerName + '%' + q + ')'); }\nif (r.reservationStatus) { const f = r.demandSourceTypeId === '5' ? 'ReservationStatusMeaning' : 'ReservationStatus'; parts.push(f + '=' + q + r.reservationStatus + q); }\nconst pQuery = parts.join(' AND ');\nconst binds = [];\nif (itemId) { binds.push('BindItemId=' + itemId); }\nif (r.expectedStartDate) { binds.push('BindExpectedStartDate=' + r.expectedStartDate); }\nif (r.expectedEndDate) { binds.push('BindExpectedEndDate=' + r.expectedEndDate); }\nlet pFinder = '';\nif (binds.length > 0) { pFinder = '&finder=filterByItemExpectedDate;' + binds.join(','); }\nconst demandRoute = r.demandSourceTypeId === '5' ? 'WORK_ORDER' : 'ORDER';\nreturn { pQuery: pQuery, pFinder: pFinder, demandRoute: demandRoute, itemId: itemId };",
            "returnType": "object"
          },
          "outcomes": {
            "success": "42"
          },
          "inputs": [],
          "diagram": {
            "x": 5675,
            "y": 7204
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "10",
          "code": "RESOLVE_DEMAND_HEADER_QUERY",
          "type": "CODE",
          "metadata": {
            "name": "Resolve Demand Header Query",
            "sourceCode": "const r = $context.$nodes.CLASSIFY_REQUEST.$output.result; const q = String.fromCharCode(39); let pQuery = 'DemandSourceHeaderNumber=' + q + (r.demandSourceHeaderNumber || '') + q; if (r.demandSourceTypeId) { pQuery = pQuery + ' AND DemandSourceTypeId=' + q + r.demandSourceTypeId + q; } return { pQuery: pQuery };",
            "returnType": "object"
          },
          "outcomes": {
            "success": "16"
          },
          "inputs": [],
          "diagram": {
            "x": 5000,
            "y": 7204
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "11",
          "code": "PREPARE_DELETE_QUERY",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Delete Query",
            "sourceCode": "const r = $context.$nodes.CLASSIFY_REQUEST.$output.result; const q = String.fromCharCode(39); const reallocate = r.action === 'DeleteAndReallocate'; const headerNumber = reallocate ? (r.deleteDemandSourceHeaderNumber || '') : (r.demandSourceHeaderNumber || ''); const typeId = reallocate ? (r.deleteDemandSourceTypeId || '') : (r.demandSourceTypeId || ''); let pQuery = 'DemandSourceHeaderNumber=' + q + headerNumber + q; if (typeId) { pQuery = pQuery + ' AND DemandSourceTypeId=' + q + typeId + q; } return { pQuery: pQuery };",
            "returnType": "object"
          },
          "outcomes": {
            "success": "24"
          },
          "inputs": [],
          "diagram": {
            "x": 11000,
            "y": 7426
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "12",
          "code": "PREPARE_CREATE_QUERY",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Create Query",
            "sourceCode": "const r = $context.$nodes.CLASSIFY_REQUEST.$output.result;\nconst q = String.fromCharCode(39);\nconst v = $context.$nodes.VALIDATE_ITEM.$output;\nconst itemId = (v && v.items && v.items.length > 0 && v.items[0].ItemId) ? v.items[0].ItemId : '';\nconst parts = [];\nif (r.organizationCode) { parts.push('OrganizationCode=' + q + r.organizationCode + q); }\nif (r.customerName) { parts.push('upper(customerName) like upper(' + q + '%' + r.customerName + '%' + q + ')'); }\nif (r.reservationStatus) { parts.push('ReservationStatus=' + q + r.reservationStatus + q); }\nconst pQuery = parts.join(' AND ');\nconst binds = [];\nif (itemId) { binds.push('BindItemId=' + itemId); }\nif (r.expectedStartDate) { binds.push('BindExpectedStartDate=' + r.expectedStartDate); }\nif (r.expectedEndDate) { binds.push('BindExpectedEndDate=' + r.expectedEndDate); }\nlet pFinder = '';\nif (binds.length > 0) { pFinder = '&finder=filterByItemExpectedDate;' + binds.join(','); }\nreturn { pQuery: pQuery, pFinder: pFinder, itemId: itemId };",
            "returnType": "object"
          },
          "outcomes": {
            "success": "21"
          },
          "inputs": [],
          "diagram": {
            "x": 9350,
            "y": 7426
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
