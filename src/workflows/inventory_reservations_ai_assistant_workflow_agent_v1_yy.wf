          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"totalResults\": {\n      \"type\": \"integer\"\n    },\n    \"count\": {\n      \"type\": \"integer\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"integer\"\n    },\n    \"offset\": {\n      \"type\": \"integer\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"href\": {\n            \"type\": \"string\"\n          },\n          \"rel\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"self\",\n              \"lov\",\n              \"parent\",\n              \"canonical\",\n              \"child\",\n              \"enclosure\",\n              \"action\",\n              \"custom\"\n            ]\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"kind\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"collection\",\n              \"item\",\n              \"describe\",\n              \"other\"\n            ]\n          }\n        },\n        \"additionalProperties\": false\n      }\n    },\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"@context\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"key\": {\n                \"type\": \"string\"\n              },\n              \"headers\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"ETag\": {\n                    \"type\": \"string\"\n                  }\n                },\n                \"additionalProperties\": false\n              },\n              \"links\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"href\": {\n                      \"type\": \"string\"\n                    },\n                    \"rel\": {\n                      \"type\": \"string\",\n                      \"enum\": [\n                        \"self\",\n                        \"lov\",\n                        \"parent\",\n                        \"canonical\",\n                        \"child\",\n                        \"enclosure\",\n                        \"action\",\n                        \"custom\"\n                      ]\n                    },\n                    \"name\": {\n                      \"type\": \"string\"\n                    },\n                    \"kind\": {\n                      \"type\": \"string\",\n                      \"enum\": [\n                        \"collection\",\n                        \"item\",\n                        \"describe\",\n                        \"other\"\n                      ]\n                    }\n                  },\n                  \"additionalProperties\": false\n                }\n              }\n            },\n            \"additionalProperties\": false\n          },\n          \"OrganizationId\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\",\n                \"format\": \"BigInt\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"OrganizationName\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"OrganizationCode\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"AssemblyItemId\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\",\n                \"format\": \"BigInt\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"AssemblyItem\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"WorkOrderId\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\",\n                \"format\": \"BigInt\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"WorkOrderNumber\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"DemandProjectId\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\",\n                \"format\": \"BigInt\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"DemandProjectNumber\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"DemandTaskId\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\",\n                \"format\": \"BigInt\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"DemandTaskNumber\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"TotalLines\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\",\n                \"format\": \"BigDecimal\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"ReservationStatus\": {\n            \"anyOf\": [\n              {\n                \"type\": \"integer\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"ReservationStatusMeaning\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          },\n          \"ExpectedDate\": {\n            \"anyOf\": [\n              {\n                \"type\": \"string\",\n                \"format\": \"date\"\n              },\n              {\n                \"type\": \"null\"\n              }\n            ]\n          }\n        },\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ]\n}"
